# Never add VITE_ to these keys. All credentials belong on the backend.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
PINECONE_API_KEY=
# Dense vector index, 384 dimensions, cosine metric. Copy its HTTPS host URL.
PINECONE_INDEX_HOST=
SUPABASE_URL=
# Use the server-side service_role key (or a Supabase secret key).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-pdfs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Fixed embedding model: Xenova/all-MiniLM-L6-v2 (384 dimensions).
